# Copy this file to .env and fill it in for local development.
# config/settings/base.py loads .env automatically; variables set in the shell win.
# On Vercel, set these in the project settings instead (no .env file is deployed).
# Never commit real values.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Required in production. Encrypts the authenticator (MFA) secrets in the database.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Locally it may stay empty: a key is derived from DJANGO_SECRET_KEY when DJANGO_DEBUG=True.
MFA_ENCRYPTION_KEY=

# Local development only. Keep False in production.
DJANGO_DEBUG=True

# Comma-separated. On Vercel add your domain, e.g. conceito-os.vercel.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# MySQL (the database is not provisioned yet)
MYSQL_DATABASE=conceito_os
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Keep 0 on Vercel (serverless). Raise locally if you want connection reuse.
DJANGO_CONN_MAX_AGE=0

# Email. Locally the Mailpit container catches it (web inbox: http://127.0.0.1:8025).
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
SITE_URL=http://127.0.0.1:8080

# First administrator: python manage.py create_initial_admin
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_ORGANIZATION="Conceito Co"
