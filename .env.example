# Copy this file to .env and fill it in for local development.
# config/settings/base.py loads .env automatically; variables set in the shell win.
# On Vercel, set these in the project settings instead (no .env file is deployed).
# Never commit real values.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Required in production. Encrypts the authenticator (MFA) secrets in the database.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Locally it may stay empty: a key is derived from DJANGO_SECRET_KEY when DJANGO_DEBUG=True.
MFA_ENCRYPTION_KEY=

# Local development only. Keep False in production.
DJANGO_DEBUG=True

# Comma-separated. On Vercel add your domain, e.g. conceito-os.vercel.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL (production). Paste the real strings into your .env file, never here.
#   DATABASE_URL_READWRITE: the primary. Every write goes here, and reads that must be current.
#   DATABASE_URL_READONLY:  optional read-only connection (a replica or a SELECT-only role).
#                           Lists, counts and reports read from it. Leave empty to use the primary only.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Percent-encode special characters in the password (for example @ becomes %40).
DATABASE_URL_READWRITE=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL_READONLY=
# Connection tuning. Defaults suit serverless (Vercel). Values are PROPOSALS, checked by the load test.
DB_CONN_MAX_AGE=0
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
# Vercel only: production builds run migrations (vercel_build.py). Set 0 to skip them.
RUN_MIGRATIONS=1
# Seconds after a change during which the same person reads from the primary (PROPOSAL: 5).
DB_PRIMARY_STICKY_SECONDS=5

# Local development without DATABASE_URL_READWRITE: the Docker PostgreSQL (docker-compose.yml).
POSTGRES_DB=conceito_os
POSTGRES_USER=conceito
POSTGRES_PASSWORD=conceito-local-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432


# Email. Locally the Mailpit container catches it (web inbox: http://127.0.0.1:8025).
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
# Production: the provider's login (mark the password as Sensitive in Vercel).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Locally (Mailpit) keep False. In production set True for port 587 (STARTTLS), or EMAIL_USE_SSL=True for 465.
EMAIL_USE_TLS=False
# The sender address shown in emails, and the address people are pointed to for help.
DEFAULT_FROM_EMAIL=Conceito OS <no-reply@conceito.com.br>
CONTACT_EMAIL=contato@conceito.com.br
SITE_URL=http://127.0.0.1:8080

# First administrator: python manage.py create_initial_admin
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_ORGANIZATION="Conceito Co"

# Signed-in people are signed out after this many seconds without activity (TD-S8, PROPOSAL: 8 hours).
SESSION_IDLE_TIMEOUT_SECONDS=28800
