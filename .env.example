# Reference list of environment variables. Django does NOT read this file.
# Set the variables in your shell (see README.md), or in the Vercel project settings.
# Never commit real values.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Local development only. Keep False in production.
DJANGO_DEBUG=True

# Comma-separated. On Vercel add your domain, e.g. conceito-os.vercel.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# MySQL (the database is not provisioned yet)
MYSQL_DATABASE=conceito_os
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Keep 0 on Vercel (serverless). Raise locally if you want connection reuse.
DJANGO_CONN_MAX_AGE=0
