# --- Business rule messages (raised by the domain, translated at the web edge) --
msgid "The person responsible must be a member of the same organization."
msgstr "O responsável precisa ser membro da mesma organização."

msgid "This content is not in internal review."
msgstr "Este conteúdo não está em revisão interna."

